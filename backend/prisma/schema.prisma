generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  initials     String
  title        String
  location     String
  phone        String
  email        String  @unique
  linkedin     String
  telegram     String
  tagline      String
  summary      String
  availability String
  skills       Skill[]
}

model Skill {
  id        String  @id @default(uuid())
  name      String
  category  String
  featured  Boolean @default(false)
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, featured, sortOrder])
}
